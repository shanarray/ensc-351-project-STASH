#include "hal/lcd.h"
#include <stdio.h>
#include <unistd.h>

int main(void)
{
    printf("Initializing LCD...\n");

    LCD_init();

    LCD_clear();
    LCD_setCursor(0, 0);
    LCD_printString("Hello World!");

    LCD_setCursor(1, 0);
    LCD_printString("BeagleY-AI");

    sleep(5);

    LCD_cleanup();

    printf("LCD test finished.\n");
    return 0;
}
